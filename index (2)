<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Roti Gembong | Freshly Baked, Made with Love</title>

  <meta
    name="description"
    content="Roti Gembong - bakery modern dengan roti, pastry, cake, dan berbagai produk bakery fresh setiap hari."
  />
  <meta name="keywords" content="Roti Gembong, bakery, toko roti, roti fresh, pastry, cake, roti gembong" />
  <meta name="author" content="Roti Gembong" />

  <meta property="og:title" content="Roti Gembong | Freshly Baked, Made with Love" />
  <meta property="og:description" content="Nikmati roti dan bakery fresh berkualitas dari Roti Gembong." />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  />

  <style>
    :root {
      --cream: #f8f1e7;
      --cream-light: #fffaf3;
      --brown: #4a2e20;
      --brown-dark: #2d1b14;
      --brown-soft: #765442;
      --caramel: #b77a4b;
      --gold: #c79a62;
      --white: #ffffff;
      --text: #3d2921;
      --muted: #806e65;
      --border: rgba(74, 46, 32, .12);
      --shadow: 0 20px 60px rgba(55, 34, 23, .10);
      --radius: 24px;
      --transition: all .35s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Poppins", sans-serif;
      background: var(--cream-light);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    img {
      width: 100%;
      display: block;
      object-fit: cover;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
    }

    section {
      padding: 100px 6%;
    }

    .container {
      width: min(1180px, 100%);
      margin: auto;
    }

    .section-heading {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 55px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--caramel);
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .eyebrow::before,
    .eyebrow::after {
      content: "";
      width: 25px;
      height: 1px;
      background: var(--gold);
    }

    h1, h2, h3 {
      font-family: "Playfair Display", serif;
      line-height: 1.15;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      color: var(--brown-dark);
    }

    .section-heading p {
      margin-top: 15px;
      color: var(--muted);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 14px 25px;
      border-radius: 999px;
      font-size: .9rem;
      font-weight: 600;
      transition: var(--transition);
    }

    .btn-primary {
      background: var(--brown);
      color: white;
      box-shadow: 0 12px 30px rgba(74, 46, 32, .2);
    }

    .btn-primary:hover {
      background: var(--caramel);
      transform: translateY(-3px);
    }

    .btn-outline {
      border: 1px solid rgba(255,255,255,.55);
      color: white;
      background: rgba(255,255,255,.08);
      backdrop-filter: blur(10px);
    }

    .btn-outline:hover {
      background: white;
      color: var(--brown);
    }

    /* NAVBAR */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 20px 6%;
      transition: var(--transition);
    }

    .navbar.scrolled {
      background: rgba(255,250,243,.96);
      backdrop-filter: blur(15px);
      padding: 13px 6%;
      box-shadow: 0 5px 25px rgba(50,30,20,.08);
    }

    .nav-container {
      width: min(1250px, 100%);
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: "Playfair Display", serif;
      font-size: 1.7rem;
      font-weight: 700;
      color: white;
      letter-spacing: -.5px;
    }

    .navbar.scrolled .logo {
      color: var(--brown);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
      list-style: none;
    }

    .nav-links a {
      color: white;
      font-size: .86rem;
      font-weight: 500;
      position: relative;
    }

    .navbar.scrolled .nav-links a {
      color: var(--text);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -6px;
      width: 0;
      height: 2px;
      background: var(--caramel);
      transition: .3s;
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-cta {
      padding: 10px 18px;
      border-radius: 999px;
      background: white;
      color: var(--brown) !important;
    }

    .navbar.scrolled .nav-cta {
      background: var(--brown);
      color: white !important;
    }

    .hamburger {
      display: none;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--brown);
      color: white;
      font-size: 1.1rem;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      background:
        linear-gradient(90deg, rgba(38,22,15,.78), rgba(38,22,15,.25)),
        url("https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=2000&q=85")
        center/cover;
      color: white;
    }

    .hero-content {
      width: min(1180px, 100%);
      margin: auto;
      padding: 120px 6% 70px;
    }

    .hero-text {
      max-width: 700px;
      animation: fadeUp 1s ease both;
    }

    .hero-badge {
      display: inline-block;
      padding: 8px 15px;
      border: 1px solid rgba(255,255,255,.4);
      border-radius: 999px;
      background: rgba(255,255,255,.1);
      backdrop-filter: blur(8px);
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(3.1rem, 7vw, 6.3rem);
      margin-bottom: 22px;
    }

    .hero p {
      max-width: 620px;
      color: rgba(255,255,255,.87);
      font-size: 1rem;
      margin-bottom: 32px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .hero-decoration {
      position: absolute;
      right: 7%;
      bottom: 8%;
      font-size: 4rem;
      color: rgba(255,255,255,.16);
      transform: rotate(-15deg);
    }

    /* ABOUT */
    .about {
      background: var(--cream-light);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-images {
      position: relative;
      min-height: 520px;
    }

    .about-image {
      position: absolute;
      overflow: hidden;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .about-image img {
      height: 100%;
    }

    .about-image.one {
      width: 70%;
      height: 390px;
      top: 0;
      left: 0;
    }

    .about-image.two {
      width: 55%;
      height: 300px;
      right: 0;
      bottom: 0;
      border: 10px solid var(--cream-light);
    }

    .about-content .eyebrow {
      justify-content: flex-start;
    }

    .about-content h2 {
      margin-bottom: 20px;
    }

    .about-content > p {
      color: var(--muted);
      margin-bottom: 30px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 30px;
    }

    .stat {
      border-left: 2px solid var(--gold);
      padding-left: 16px;
    }

    .stat strong {
      display: block;
      font-family: "Playfair Display", serif;
      font-size: 1.8rem;
      color: var(--brown);
    }

    .stat span {
      font-size: .75rem;
      color: var(--muted);
    }

    /* PRODUCTS */
    .products {
      background: #f3e8da;
    }

    .filter-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 40px;
    }

    .filter-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--brown-soft);
      padding: 10px 20px;
      border-radius: 999px;
      transition: var(--transition);
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--brown);
      color: white;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .product-card {
      background: white;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 10px 35px rgba(60,35,20,.07);
      transition: var(--transition);
      animation: scaleIn .45s ease both;
    }

    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow);
    }

    .product-image {
      height: 220px;
      position: relative;
      overflow: hidden;
    }

    .product-image img {
      height: 100%;
      transition: transform .6s ease;
    }

    .product-card:hover .product-image img {
      transform: scale(1.07);
    }

    .product-badge {
      position: absolute;
      top: 13px;
      left: 13px;
      background: var(--caramel);
      color: white;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: .65rem;
      font-weight: 600;
    }

    .product-info {
      padding: 20px;
    }

    .product-info h3 {
      font-size: 1.25rem;
      margin-bottom: 7px;
    }

    .product-info p {
      color: var(--muted);
      font-size: .76rem;
      min-height: 50px;
    }

    .product-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-top: 15px;
    }

    .price {
      font-weight: 700;
      color: var(--caramel);
    }

    .mini-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--brown);
      color: white;
      transition: .3s;
    }

    .mini-btn:hover {
      background: var(--caramel);
      transform: rotate(8deg);
    }

    /* BEST SELLER */
    .best-seller {
      background: var(--cream-light);
    }

    .favorite-grid {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 25px;
    }

    .favorite {
      position: relative;
      min-height: 440px;
      border-radius: var(--radius);
      overflow: hidden;
      color: white;
      display: flex;
      align-items: flex-end;
      background: #333;
      box-shadow: var(--shadow);
    }

    .favorite::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 30%, rgba(25,13,8,.9));
    }

    .favorite img {
      position: absolute;
      inset: 0;
      height: 100%;
      transition: .6s;
    }

    .favorite:hover img {
      transform: scale(1.07);
    }

    .favorite-content {
      position: relative;
      z-index: 2;
      padding: 25px;
    }

    .favorite-content h3 {
      font-size: 1.5rem;
      margin-bottom: 5px;
    }

    .favorite-content p {
      font-size: .78rem;
      opacity: .85;
      margin-bottom: 15px;
    }

    /* WHY */
    .why {
      background: var(--brown);
      color: white;
    }

    .why .section-heading h2 {
      color: white;
    }

    .why .section-heading p {
      color: rgba(255,255,255,.7);
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
    }

    .why-card {
      text-align: center;
      padding: 30px 18px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius);
      transition: .3s;
    }

    .why-card:hover {
      transform: translateY(-7px);
      background: rgba(255,255,255,.07);
      border-color: var(--gold);
    }

    .why-card i {
      color: var(--gold);
      font-size: 1.8rem;
      margin-bottom: 18px;
    }

    .why-card h3 {
      font-size: 1.05rem;
      margin-bottom: 8px;
    }

    .why-card p {
      color: rgba(255,255,255,.6);
      font-size: .72rem;
    }

    /* PROCESS */
    .process {
      background: #fbf5ec;
    }

    .timeline {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
      position: relative;
    }

    .timeline::before {
      content: "";
      position: absolute;
      top: 36px;
      left: 10%;
      right: 10%;
      height: 1px;
      background: var(--gold);
    }

    .step {
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .step-number {
      width: 72px;
      height: 72px;
      margin: auto auto 25px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--cream);
      border: 1px solid var(--gold);
      color: var(--brown);
      font-family: "Playfair Display", serif;
      font-size: 1.4rem;
    }

    .step h3 {
      font-size: 1.25rem;
      margin-bottom: 10px;
    }

    .step p {
      color: var(--muted);
      font-size: .78rem;
    }

    /* PROMO */
    .promo {
      padding: 80px 6%;
    }

    .promo-box {
      max-width: 1100px;
      margin: auto;
      border-radius: 35px;
      padding: 70px;
      background:
        linear-gradient(90deg, rgba(54,29,17,.92), rgba(90,51,28,.72)),
        url("https://images.unsplash.com/photo-1558961363-fa8fdf82db35?auto=format&fit=crop&w=1800&q=80")
        center/cover;
      color: white;
      text-align: center;
    }

    .promo-box h2 {
      color: white;
      margin-bottom: 12px;
    }

    .promo-box p {
      color: rgba(255,255,255,.78);
      margin-bottom: 25px;
    }

    .countdown {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin: 30px 0;
    }

    .time-box {
      min-width: 75px;
      padding: 12px;
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 15px;
    }

    .time-box strong {
      display: block;
      font-size: 1.5rem;
    }

    .time-box span {
      font-size: .62rem;
      opacity: .7;
      text-transform: uppercase;
    }

    /* GALLERY */
    .gallery {
      background: var(--cream-light);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 210px;
      gap: 15px;
    }

    .gallery-item {
      overflow: hidden;
      border-radius: 18px;
      cursor: pointer;
    }

    .gallery-item:nth-child(1),
    .gallery-item:nth-child(5) {
      grid-row: span 2;
    }

    .gallery-item img {
      height: 100%;
      transition: .5s;
    }

    .gallery-item:hover img {
      transform: scale(1.07);
    }

    /* REVIEWS */
    .reviews {
      background: #f1e5d7;
    }

    .review-wrapper {
      max-width: 850px;
      margin: auto;
      position: relative;
    }

    .review-card {
      background: white;
      border-radius: 30px;
      padding: 45px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .stars {
      color: #c89039;
      letter-spacing: 3px;
      margin-bottom: 18px;
    }

    .review-text {
      font-family: "Playfair Display", serif;
      font-size: 1.5rem;
      color: var(--brown);
      margin-bottom: 25px;
    }

    .review-user {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
    }

    .review-user strong {
      display: block;
      text-align: left;
    }

    .review-user span {
      font-size: .7rem;
      color: var(--muted);
    }

    .review-controls {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 25px;
    }

    .review-control {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--brown);
      color: white;
    }

    /* CUSTOM ORDER */
    .custom-order {
      background: var(--cream-light);
    }

    .custom-box {
      background: #ead7c0;
      border-radius: 30px;
      padding: 55px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .custom-box h2 {
      margin-bottom: 15px;
    }

    .custom-box > div > p {
      color: var(--muted);
      margin-bottom: 25px;
    }

    .custom-list {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 12px;
      list-style: none;
    }

    .custom-list li {
      font-size: .8rem;
      font-weight: 600;
    }

    .custom-list i {
      color: var(--caramel);
      margin-right: 7px;
    }

    /* INSTAGRAM */
    .instagram {
      background: #fbf5ec;
    }

    .insta-grid {
      display: grid;
      grid-template-columns: repeat(6,1fr);
      gap: 10px;
      margin-bottom: 30px;
    }

    .insta-item {
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: 15px;
    }

    .insta-item img {
      height: 100%;
      transition: .5s;
    }

    .insta-item:hover img {
      transform: scale(1.08);
    }

    .insta-link {
      text-align: center;
    }

    /* CTA */
    .cta {
      padding: 0 6% 100px;
      background: #fbf5ec;
    }

    .cta-box {
      min-height: 430px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      border-radius: 35px;
      padding: 60px 25px;
      background:
        linear-gradient(rgba(48,26,17,.78), rgba(48,26,17,.78)),
        url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1800&q=80")
        center/cover;
      color: white;
    }

    .cta-content {
      max-width: 700px;
    }

    .cta h2 {
      color: white;
      font-size: clamp(2.2rem, 5vw, 4rem);
      margin-bottom: 15px;
    }

    .cta p {
      color: rgba(255,255,255,.8);
      margin-bottom: 25px;
    }

    /* CONTACT */
    .contact {
      background: var(--cream-light);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 40px;
    }

    .contact-info {
      padding: 15px;
    }

    .contact-item {
      display: flex;
      gap: 16px;
      margin-bottom: 25px;
    }

    .contact-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #ead7c0;
      color: var(--brown);
    }

    .contact-item h3 {
      font-size: 1rem;
      margin-bottom: 3px;
    }

    .contact-item p,
    .contact-item a {
      font-size: .78rem;
      color: var(--muted);
    }

    .map {
      min-height: 420px;
      overflow: hidden;
      border-radius: 25px;
      box-shadow: var(--shadow);
    }

    .map iframe {
      width: 100%;
      height: 100%;
      min-height: 420px;
      border: 0;
    }

    /* FOOTER */
    footer {
      background: var(--brown-dark);
      color: white;
      padding: 70px 6% 25px;
    }

    .footer-grid {
      width: min(1180px,100%);
      margin: auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 45px;
      padding-bottom: 50px;
    }

    .footer-brand h2 {
      color: white;
      font-size: 2rem;
      margin-bottom: 12px;
    }

    .footer-brand p,
    footer li,
    footer a {
      color: rgba(255,255,255,.62);
      font-size: .76rem;
    }

    footer h3 {
      font-family: "Poppins", sans-serif;
      font-size: .85rem;
      margin-bottom: 18px;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin-bottom: 8px;
    }

    footer a:hover {
      color: white;
    }

    .socials {
      display: flex;
      gap: 9px;
      margin-top: 18px;
    }

    .socials a {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(255,255,255,.08);
      transition: .3s;
    }

    .socials a:hover {
      background: var(--caramel);
      color: white;
      transform: translateY(-3px);
    }

    .copyright {
      width: min(1180px,100%);
      margin: auto;
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,.1);
      text-align: center;
      color: rgba(255,255,255,.45);
