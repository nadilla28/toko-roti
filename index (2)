      display: grid;
      place-items: center;
      background: #25d366;
      color: white;
      font-size: 1.65rem;
      z-index: 999;
      box-shadow: 0 10px 30px rgba(37,211,102,.35);
      animation: pulse 2s infinite;
    }

    /* BACK TOP */
    .back-top {
      position: fixed;
      right: 90px;
      bottom: 25px;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      background: var(--brown);
      color: white;
      opacity: 0;
      visibility: hidden;
      transition: .3s;
      z-index: 900;
    }

    .back-top.show {
      opacity: 1;
      visibility: visible;
    }

    /* LIGHTBOX */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(20,10,6,.9);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px;
      opacity: 0;
      visibility: hidden;
      z-index: 2000;
      transition: .3s;
    }

    .lightbox.active {
      opacity: 1;
      visibility: visible;
    }

